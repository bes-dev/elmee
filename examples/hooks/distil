#!/usr/bin/env python3
"""Distil a finished session into durable notes.

Wire it up in `.elmee/hooks.json`:

    { "after_session": [ { "command": "examples/hooks/distil" } ] }

The agent already keeps three layers: the transcript is what happened,
`.elmee/memory/` is what was learnt, and skills are what can be re-run. What
is missing between them is a pump, and this is it — a step that reads a
finished session and writes down the part worth keeping.

It is deliberately not clever. Everything expensive is behind a cheap test:
most sessions are a question and an answer, and re-reading those with a model
would cost more than the work did. Only a session that changed something, or
went on long enough to have learnt something, is worth a second look.
"""

import json
import os
import subprocess
import sys

# A distillation run is itself a session, and its ending would call this hook
# again. The guard is the env var, not the model's good sense.
GUARD = "ELMEE_DISTILLING"

# What counts as a session worth reading back. Tuned to be dull: a run that
# edited nothing and made a handful of tool calls has nothing to teach.
MIN_TOOL_CALLS = 8
MIN_PERSON_TURNS = 3

PROMPT = """\
Read the transcript at {session}. It is a finished session in this project.

Write down only what would save time next time and is not already obvious from
the code: a constraint that turned out to be true, an approach that failed and
why, a command that is the right one here, a preference this person stated.
Use the memory tool — project scope for facts about this repository, user scope
for how this person works.

Rules, in order of importance:
- At most three notes. Nothing is better than filler; most sessions teach
  nothing and the right answer is to record none.
- Never restate what the code, the tests or the README already say.
- A note must be durable. Anything true only of this task is not a note.
- Before adding, read the existing memory: extend or correct an entry rather
  than laying a near-duplicate beside it.
- Do not touch anything else. No edits, no commands beyond reading.

Then stop. Report in one line what you recorded, or that there was nothing.
"""


def worth_reading(path):
    """A cheap pass over the transcript, with no model involved."""
    tool_calls = 0
    person_turns = 0
    edited = False
    try:
        with open(path, encoding="utf8", errors="replace") as transcript:
            for line in transcript:
                try:
                    message = json.loads(line).get("message") or {}
                except ValueError:
                    continue
                role = message.get("role")
                if role == "user" and not str(message.get("content", "")).startswith("<"):
                    person_turns += 1
                for call in message.get("tool_calls") or []:
                    tool_calls += 1
                    if call.get("function", {}).get("name") == "apply_patch":
                        edited = True
    except OSError:
        return False
    return edited or tool_calls >= MIN_TOOL_CALLS or person_turns >= MIN_PERSON_TURNS


def main():
    if os.environ.get(GUARD):
        return 0
    try:
        event = json.load(sys.stdin)
    except ValueError:
        return 0
    session = event.get("session")
    if not session or not os.path.isfile(session):
        return 0
    if not worth_reading(session):
        return 0

    # Detached, so an editor closing a buffer and a script reading a transcript
    # are not the same wait. `--no-session` keeps the distillation itself out
    # of the record it is distilling.
    log = open(os.path.join(event.get("cwd", "."), ".elmee", "distil.log"), "a")
    subprocess.Popen(
        ["elmee", "--no-session", PROMPT.format(session=session)],
        cwd=event.get("cwd"),
        env=dict(os.environ, **{GUARD: "1"}),
        stdin=subprocess.DEVNULL,
        stdout=log,
        stderr=log,
        start_new_session=True,
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
